# Serves the React build and reverse-proxies the API. The application
# only exposes HTTP internally; TLS is terminated by the operator's own
# proxy in front of this container (§12).
#
# A template: each WEB_… value is filled in at start from the container's
# environment (docker-compose.yml, .env; defaults in nginx/Dockerfile;
# docs/guides/configuration.md). nginx's own $variables are left alone.

# The access log never shows an API token: an iPhone Shortcut sends it in
# the URL (?token=…), logged as token=*** (the API's own log does the same).
map $request_uri $logged_uri {
    "~^(?<head>[^?]*\?(?:.*&)?(?:access_)?token=)[^&]*(?<tail>.*)$" "${head}***${tail}";
    default $request_uri;
}

# rt: seconds the whole request took; api: seconds the API took to answer
# (« - » for a page or a file served by nginx itself).
log_format no_token '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $logged_uri $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" rt=$request_time api=$upstream_response_time';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${WEB_MAX_BODY_MB}m;
    access_log /var/log/nginx/access.log no_token;

    # The API's address is asked of Docker's DNS again (every 10 s by
    # default, WEB_DNS_TTL_S): an
    # update that rebuilds api alone gives its new container a new
    # address, and a name resolved once at start would keep the old one
    # until nginx restarts (« connect() failed (111: Connection
    # refused) », 502 on every call while the API runs fine).
    resolver 127.0.0.11 valid=${WEB_DNS_TTL_S}s ipv6=off;
    set $api http://api:8000;

    # Text is compressed on the way out: the page's code 1 MB → 0.3 MB,
    # a dashboard's JSON 594 KB → 46 KB (docs/performance.md). Answers
    # that carry a session or a token are not (below): with compression,
    # their size could leak a secret (BREACH).
    gzip on;
    gzip_comp_level ${WEB_GZIP_LEVEL};
    gzip_min_length ${WEB_GZIP_MIN_BYTES};
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/javascript text/css
               text/plain image/svg+xml application/manifest+json;

    # Security headers (§12.1). The SPA loads no third-party origins.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # strict-origin (not no-referrer) so map tile CDNs receive an origin;
    # several block refererless requests.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # img-src allows raster map tiles for the GPS route map (Carto default,
    # OpenStreetMap allowed for those who configure VITE_TILE_URL).
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://api.maptiler.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Sign-in, session renewal, API tokens, a Shortcut with its token:
    # sent as is, never compressed (see gzip above).
    location ~ ^/api/v1/(auth/|tokens|sync/shortcut) {
        gzip off;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_request_buffering off;
    }

    # Large multipart upload (Apple Health export, hundreds of MB):
    # no size cap, streamed straight to the API, generous timeouts.
    location = /api/v1/imports/apple-health {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_read_timeout ${WEB_IMPORT_TIMEOUT_S}s;
        proxy_send_timeout ${WEB_IMPORT_TIMEOUT_S}s;
    }

    # Health Auto Export posts its whole history as one large JSON body
    # (tens of MB) and the server writes thousands of rows, so lift the
    # size cap and give it a generous processing timeout.
    location = /api/v1/sync/auto-export {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 0;
        proxy_read_timeout ${WEB_SYNC_TIMEOUT_S}s;
        proxy_send_timeout ${WEB_SYNC_TIMEOUT_S}s;
        # Streamed to the API as it arrives: the health data never lands
        # in a temporary file of nginx (« a client request body is
        # buffered to a temporary file »). HTTP/1.1 so a chunked body
        # streams too.
        proxy_http_version 1.1;
        proxy_request_buffering off;
    }

    location /api/ {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout ${WEB_API_TIMEOUT_S}s;
        # Bodies sent (a meal's photos, a document, a Shortcut's JSON)
        # are streamed to the API: never written to nginx's disk.
        proxy_http_version 1.1;
        proxy_request_buffering off;
        # Answers of up to 2 MB (a meal photo; WEB_PROXY_BUFFERS ×
        # WEB_PROXY_BUFFER_KB) stay in memory; a larger one (an export, a
        # report) spills to a temporary file, as before.
        proxy_buffer_size ${WEB_PROXY_BUFFER_KB}k;
        proxy_buffers ${WEB_PROXY_BUFFERS} ${WEB_PROXY_BUFFER_KB}k;
        proxy_busy_buffers_size ${WEB_PROXY_BUSY_KB}k;
    }

    location = /health {
        proxy_pass $api/health;
    }

    # SPA fallback: unknown routes are handled by the client router.
    # index.html and version.json are always revalidated, so a rebuilt
    # image is picked up by the next load (« Nouvelle version installée »).
    # (expires, not add_header: the security headers above stay inherited)
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }

    # Long-cache immutable build assets.
    location /assets/ {
        expires ${WEB_ASSETS_CACHE_DAYS}d;
        add_header Cache-Control "public, immutable";
    }
}

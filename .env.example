# ============================================================================
# Phoenix Health Hub — environment configuration
# Copy to .env and edit. NEVER commit the real .env. install.sh generates a
# strong SECRET_KEY automatically when it first creates .env.
# ============================================================================

# --- Core ------------------------------------------------------------------
APP_NAME=Phoenix Health Hub
ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Security --------------------------------------------------------------
# Must be at least 32 characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
JWT_ALGORITHM=HS256

# Comma-separated list of allowed browser origins (empty = same-origin only).
CORS_ORIGINS=

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=phoenix
# DATABASE_URL is set by docker-compose from the values above. Override it
# only when running the API outside Docker.
# DATABASE_URL=postgresql+asyncpg://phoenix:phoenix@localhost:5432/phoenix

# --- Redis -----------------------------------------------------------------
# REDIS_URL is set by docker-compose (redis://redis:6379/0).

# --- Initial admin (created by the seed step) ------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Locale / units --------------------------------------------------------
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_UNIT_SYSTEM=metric

# --- Media / exports (paths inside the containers) -------------------------
MEDIA_DIR=/data/media
EXPORTS_DIR=/data/exports
# Optional at-rest encryption of stored media. Leave empty to disable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_ENCRYPTION_KEY=
# Days to keep data (0 = keep forever). Purge tooling is documented.
RETENTION_DAYS=0

# --- MFA (optional TOTP) ----------------------------------------------------
MFA_ISSUER=Phoenix Health Hub

# --- AI (Ollama) -----------------------------------------------------------
# Point at your Ollama HTTP API. From inside Docker, host.docker.internal
# reaches the host machine.
OLLAMA_URL=http://host.docker.internal:11434
# One model per task (use the exact tag shown by `ollama list`):
# - VISION   : progress photos. MedGemma 1.5 (4B, image+text, trained on
#   medical images, multi-timepoint comparison) e.g. medgemma1.5; else
#   llama3.2-vision / qwen2.5vl / llava.
# - DOCUMENT : reading lab reports / FibroScan / letters (values, dates).
#   MedGemma 1.5 improved lab-report extraction; empty = VISION model.
# - TEXT     : clinical reasoning & synthesis. MedGemma 27B (medgemma:27b)
#   is the stronger medical reasoner; else llama3.1.
# Changing the VISION model makes older photo scores incomparable: use
# "Réanalyser tout l'historique" afterwards.
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
OLLAMA_DOCUMENT_MODEL=
# Max photo upload size (MB).
MAX_UPLOAD_MB=15
# Mes aliments › Code-barres: look a product up on Open Food Facts. Only
# the barcode is sent. Off by default (the hub does not go online).
FOOD_LOOKUP_ONLINE=false
# When the lookup is on: read each sheet's page again after this many
# days (the worker, each night; only the barcode is sent). 0: never.
FOOD_REFRESH_DAYS=30
OPENFOODFACTS_URL=https://world.openfoodfacts.org

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Web tier --------------------------------------------------------------
# Host port the Nginx web service listens on.
WEB_PORT=8082

# --- Map tiles (GPS route viewer) ------------------------------------------
# Baked into the web build; run `docker compose build web` after changing.
# Get a free key at https://cloud.maptiler.com (Account → API keys):
VITE_MAP_KEY=
# Or point at any raster provider (overrides VITE_MAP_KEY):
#   VITE_TILE_URL=https://{s}.tile.example.com/{z}/{x}/{y}.png
#   VITE_TILE_ATTRIB=© Example
# VITE_TILE_URL=none disables the basemap (draws only the track).
# Add any custom tile host to img-src in nginx/default.conf.
VITE_TILE_URL=
VITE_TILE_ATTRIB=

# --- MCP server (optional; docker compose --profile mcp) --------------------
# Nothing secret here: each MCP client sends its own API token created in the
# web app (Import > Jetons d'accès (API) > "Accès complet — MCP / assistant",
# scope hub:full) as "Authorization: Bearer <token>". Revoke it to cut access.
# Published on this host only by default; set 0.0.0.0 to reach it from the
# LAN (never expose it to the Internet without a VPN / authenticated proxy).
MCP_BIND=127.0.0.1
MCP_PORT=9000
# streamable-http (recommended): each request gets its JSON answer, a single
# curl can call a tool. sse: answers arrive on a separate /sse stream.
MCP_TRANSPORT=streamable-http
# Only for MCP_TRANSPORT=stdio (no HTTP header to carry a token):
# PHOENIX_API_TOKEN=

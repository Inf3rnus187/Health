# ============================================================================
# Phoenix Health Hub — environment configuration
# Copy to .env and edit. NEVER commit the real .env. install.sh generates a
# strong SECRET_KEY automatically when it first creates .env.
# ============================================================================

# --- Core ------------------------------------------------------------------
APP_NAME=Phoenix Health Hub
ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Security --------------------------------------------------------------
# Must be at least 32 characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
JWT_ALGORITHM=HS256

# Comma-separated list of allowed browser origins (empty = same-origin only).
CORS_ORIGINS=

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=phoenix
# DATABASE_URL is set by docker-compose from the values above. Override it
# only when running the API outside Docker.
# DATABASE_URL=postgresql+asyncpg://phoenix:phoenix@localhost:5432/phoenix

# --- Redis -----------------------------------------------------------------
# REDIS_URL is set by docker-compose (redis://redis:6379/0).

# --- Initial admin (created by the seed step) ------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Locale / units --------------------------------------------------------
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_UNIT_SYSTEM=metric

# --- Media / exports (paths inside the containers) -------------------------
MEDIA_DIR=/data/media
EXPORTS_DIR=/data/exports
# Optional at-rest encryption of stored media. Leave empty to disable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_ENCRYPTION_KEY=
# Days to keep data (0 = keep forever). Purge tooling is documented.
RETENTION_DAYS=0

# --- MFA (optional TOTP) ----------------------------------------------------
MFA_ISSUER=Phoenix Health Hub

# --- AI (Ollama) -----------------------------------------------------------
# Point at your Ollama HTTP API. From inside Docker, host.docker.internal
# reaches the host machine.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
# Versioned photo-analysis prompt (compare analyses over time).
PHOTO_PROMPT_VERSION=v1
# Max photo upload size (MB).
MAX_UPLOAD_MB=15

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Web tier --------------------------------------------------------------
# Host port the Nginx web service listens on.
WEB_PORT=8082

# --- Map tiles (GPS route viewer) ------------------------------------------
# Baked into the web build; run `docker compose build web` after changing.
# Get a free key at https://cloud.maptiler.com (Account → API keys):
VITE_MAP_KEY=
# Or point at any raster provider (overrides VITE_MAP_KEY):
#   VITE_TILE_URL=https://{s}.tile.example.com/{z}/{x}/{y}.png
#   VITE_TILE_ATTRIB=© Example
# VITE_TILE_URL=none disables the basemap (draws only the track).
# Add any custom tile host to img-src in nginx/default.conf.
VITE_TILE_URL=
VITE_TILE_ATTRIB=

# --- MCP server (Phase 7, optional; docker compose --profile mcp) -----------
# A scoped API token the MCP server uses to call the REST API. Create one via
# POST /api/v1/tokens (e.g. scopes read:all, write:measurements) and paste it.
PHOENIX_API_TOKEN=
MCP_PORT=9000
MCP_TRANSPORT=sse

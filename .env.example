# ============================================================================
# Phoenix Health Hub — environment configuration
# Copy to .env and edit. NEVER commit the real .env. install.sh generates a
# strong SECRET_KEY automatically when it first creates .env.
# ============================================================================

# --- Core ------------------------------------------------------------------
APP_NAME=Phoenix Health Hub
ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Security --------------------------------------------------------------
# Must be at least 32 characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
JWT_ALGORITHM=HS256

# Comma-separated list of allowed browser origins (empty = same-origin only).
CORS_ORIGINS=

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=phoenix
# DATABASE_URL is set by docker-compose from the values above. Override it
# only when running the API outside Docker.
# DATABASE_URL=postgresql+asyncpg://phoenix:phoenix@localhost:5432/phoenix

# --- Redis -----------------------------------------------------------------
# REDIS_URL is set by docker-compose (redis://redis:6379/0).

# --- Initial admin (created by the seed step) ------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Locale / units --------------------------------------------------------
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_UNIT_SYSTEM=metric

# --- Media / exports (paths inside the containers) -------------------------
MEDIA_DIR=/data/media
EXPORTS_DIR=/data/exports
# Optional at-rest encryption of stored media. Leave empty to disable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_ENCRYPTION_KEY=
# Days to keep data (0 = keep forever). Purge tooling is documented.
RETENTION_DAYS=0

# --- MFA (optional TOTP) ----------------------------------------------------
MFA_ISSUER=Phoenix Health Hub

# --- AI (Ollama) -----------------------------------------------------------
# Point at your Ollama HTTP API. From inside Docker, host.docker.internal
# reaches the host machine.
OLLAMA_URL=http://host.docker.internal:11434
# One model per task (use the exact tag shown by `ollama list`):
# - VISION   : progress photos. MedGemma 1.5 (4B, image+text, trained on
#   medical images, multi-timepoint comparison) e.g. medgemma1.5; else
#   llama3.2-vision / qwen2.5vl / llava.
# - DOCUMENT : reading lab reports / FibroScan / letters (values, dates).
#   MedGemma 1.5 improved lab-report extraction; empty = VISION model.
# - TEXT     : clinical reasoning & synthesis. MedGemma 27B (medgemma:27b)
#   is the stronger medical reasoner; else llama3.1.
# Changing the VISION model makes older photo scores incomparable: use
# "Réanalyser tout l'historique" afterwards.
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
OLLAMA_DOCUMENT_MODEL=
# Max photo upload size (MB).
MAX_UPLOAD_MB=15
# Mes aliments › Code-barres: look a product up on Open Food Facts. Only
# the barcode is sent. Off by default (the hub does not go online).
FOOD_LOOKUP_ONLINE=false
# When the lookup is on: read each sheet's page again after this many
# days (the worker, each night; only the barcode is sent). 0: never.
FOOD_REFRESH_DAYS=30
# The longest a meal's AI reading may be put off (POST /meals
# analysis_delay_min), in minutes.
MEAL_ANALYSIS_MAX_DELAY_MIN=60
OPENFOODFACTS_URL=https://world.openfoodfacts.org

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Web tier --------------------------------------------------------------
# Host port the Nginx web service listens on.
WEB_PORT=8082
# API processes answering at the same time (default 4; about one per CPU
# core, 8 at most with PostgreSQL's default 100 connections: each process
# holds up to 10).
# API_WORKERS=4

# --- Operational settings (backend/app/core/tuning.py) ----------------------
# Every size, time limit, batch, schedule and rule of the API and worker.
# Commented out: the value shown is the default. Uncomment to change, then
# `docker compose up -d`. Each one: docs/guides/configuration.md
# (« Réglages de fonctionnement »).
# Database connections (per API or worker process)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_S=30
# Worker (background jobs)
# WORKER_MAX_JOBS=10
# WORKER_JOB_TIMEOUT_S=7200
# WORKER_MAX_TRIES=1
# WORKER_KEEP_RESULT_S=3600
# AI (Ollama)
# OLLAMA_TIMEOUT_S=600
# OLLAMA_CONCURRENCY=1
# MEAL_AI_TIME_LIMIT_S=900
# MEAL_AI_MAX_TOKENS=1500
# MEAL_AI_JUDGE_TOKENS=700
# DOCUMENT_AI_TIME_LIMIT_S=1800
# DOCUMENT_AI_CHUNK_CHARS=5000
# DOCUMENT_AI_MAX_CHUNKS=8
# LABEL_AI_TIME_LIMIT_S=100
# OCR_MAX_PAGES=12
# OCR_DPI=200
# DOCUMENT_AI_VALUES_TOKENS=1024
# DOCUMENT_AI_SUMMARY_TOKENS=900
# DOCUMENT_AI_SUMMARY_CHARS=12000
# DOCUMENT_AI_REJECTED_MAX=30
# MEAL_REMARK_MAX_CHARS=300
# MEAL_INGREDIENTS_MAX_CHARS=400
# IMAGE_READ_SIDE=2048
# BARCODE_READ_SIDE=2400
# PHOTO_COMPARE_SIDE=640
# Sizes and limits
# EVIDENCE_MAX_MB=30
# MEDICAL_MAX_MB=25
# IMAGE_MAX_SIDE=1280
# MEAL_MAX_PHOTOS=6
# MEAL_MAX_FOODS=20
# MEAL_DESCRIPTION_MAX=2000
# MEAL_LINE_MAX_G=1500
# ECG_MAX_POINTS=5000
# ROUTE_MAX_POINTS=3000
# DOCUMENT_TEXT_MAX=200000
# Open Food Facts
# OPENFOODFACTS_TIMEOUT_S=10
# FOOD_REFRESH_HOUR=4
# FOOD_REFRESH_MINUTE=40
# FOOD_REFRESH_PER_NIGHT=50
# FOOD_REFRESH_PAUSE_S=1
# FOOD_REFRESH_BUDGET_S=60
# Batches (imports, syncs, rebuilds)
# IMPORT_BATCH=5000
# IMPORT_COMMIT_EVERY=50000
# IMPORT_ROLLUP_BATCH=500
# IMPORT_OBS_BATCH=1000
# ROLLUP_READ_BLOCK=20000
# SYNC_CHUNK=2000
# SYNC_ROLLUP_CHUNK=400
# CATALOG_SYNC_BATCH=5000
# DELETE_CHUNK=500
# SQL_IN_CHUNK=500
# UPLOAD_CHUNK_KB=1024
# IMPORT_REPORT_LINES=50
# CHAT_TRACE_MAX_CHARS=8000
# TRACE_SAME_TIME_S=60
# Memory
# GC_FREEZE=true
# Logs
# LOG_SLOW_MS=1000
# Updates (run/ files shared with ./update.sh)
# UPDATE_FRESH_S=180
# UPDATE_TAKEN_S=180
# UPDATE_RUNNING_S=1200
# Reconcile after an update of the hub (once per account, in the background)
# RECONCILE_AFTER_UPDATE=true
# RECONCILE_AFTER_UPDATE_DELAY_S=120
# RECONCILE_CHECK_MINUTE=35
# Work and sleep rules
# WORK_MAX_DAY_HOURS=10
# WORK_MAX_WEEK_HOURS=48
# WORK_MAX_SPREAD_HOURS=13
# WORK_MAX_SESSION_HOURS=72
# WORK_OPEN_SESSION_HOURS=16
# WORK_PAIR_MAX_HOURS=20
# WORK_TICKET_MAX_HOURS=12
# WORK_MIN_REST_HOURS=11
# WORK_LONG_SESSION_HOURS=12
# WORK_MAX_AVG_HOURS=44
# WORK_AVG_WEEKS=12
# WORK_NIGHT_START=21:00
# WORK_NIGHT_END=06:00
# SLEEP_MANUAL_MAX_HOURS=20
# WORK_CHART_WEEKS=52
# WORK_HIGHLIGHT_DAYS=20
# WORK_CONTINUOUS_HOURS=24
# WORK_STAY_HOURS=6
# WORK_MORNING_HOUR=12
# WORK_PAIR_SEARCH_HOURS=20
# WORK_CORR_MIN_PAIRS=5
# SLEEP_AWAKENING_MIN=5
# SLEEP_BLOCK_GAP_MIN=60
# SLEEP_SAMPLE_MAX_HOURS=48
# MEDICATION_FUTURE_MIN=10
# MEDICATION_LATE_ENTRY_MIN=60
# ADHERENCE_DAYS=30
# PHOTO_MIN_SIDE=300
# PHOTO_DARK=35
# PHOTO_BRIGHT=235
# PHOTO_BLURRY=12
# PHOTO_TREND_MIN_DAYS=8
# PHOTO_TREND_MIN_SPAN_DAYS=21
# PHOTO_TREND_WINDOW_DAYS=90
# PHOTO_TREND_SMOOTH_DAYS=7
# PHOTO_TREND_STABLE=0.5
# SPENDING_TOP=10
# SPENDING_LATE_FROM_HOUR=21
# SPENDING_LATE_UNTIL_HOUR=5
# Web page (sent by GET /system/settings; seconds)
# WEB_RETRY_S=5
# WEB_RENEW_MARGIN_S=180
# WEB_REFRESH_TIMEOUT_S=15
# WEB_UPDATE_CHECK_S=300
# WEB_UPDATE_LOOK_S=20
# WEB_UPDATE_STATE_S=15
# WEB_UPDATE_RECENT_S=1800
# WEB_POLL_S=5
# WEB_RECONCILE_REFRESH_S=10
# WEB_RECONCILE_REFRESH_STEPS=18
# WEB_REANALYSIS_REFRESH_S=10
# WEB_REANALYSIS_REFRESH_STEPS=12
# WEB_PHOTO_REFRESH_S=1.5,4,8,13
# WEB_RELOAD_GUARD_S=60
# WEB_PAGE_SIZES=10,25,50,100,200

# --- PostgreSQL memory (docker-compose.yml, service db) --------------------
# PostgreSQL's own defaults below. shared_buffers: about 25 % of the free
# memory at most; effective_cache_size allocates nothing; work_mem is per
# sort or grouping (a query may use several). Restarts the db (seconds).
# DB_SHARED_BUFFERS=128MB
# DB_EFFECTIVE_CACHE_SIZE=4GB
# DB_WORK_MEM=4MB
# DB_MAINTENANCE_WORK_MEM=64MB
# Shared memory of parallel queries (a ceiling; Docker gives 64 MB).
# DB_SHM_SIZE=256mb

# --- API server (gunicorn; docker-compose.yml) -----------------------------
# A process silent this long is restarted; one stopping (an update) gets
# this long to finish its requests; a kept-alive connection waits this.
# API_TIMEOUT_S=30
# API_GRACEFUL_S=30
# API_KEEPALIVE_S=2

# --- Web server (nginx/default.conf.template; docker-compose.yml) ----------
# Largest request (a meal and all its photos; keep it >= EVIDENCE_MAX_MB).
# WEB_MAX_BODY_MB=32
# Waits for the API: a call, Health Auto Export, an Apple export upload.
# WEB_API_TIMEOUT_S=120
# WEB_SYNC_TIMEOUT_S=600
# WEB_IMPORT_TIMEOUT_S=3600
# gzip level (1-9) and smallest answer compressed (bytes).
# WEB_GZIP_LEVEL=5
# WEB_GZIP_MIN_BYTES=1024
# The API's address is asked of Docker's DNS again this often.
# WEB_DNS_TTL_S=10
# Answers kept in memory: BUFFERS x BUFFER_KB; BUSY_KB >= BUFFER_KB and
# < (BUFFERS - 1) x BUFFER_KB.
# WEB_PROXY_BUFFER_KB=64
# WEB_PROXY_BUFFERS=32
# WEB_PROXY_BUSY_KB=128
# Browser cache of the site's versioned files (days).
# WEB_ASSETS_CACHE_DAYS=30

# --- Map tiles (GPS route viewer) ------------------------------------------
# Baked into the web build; run `docker compose build web` after changing.
# Get a free key at https://cloud.maptiler.com (Account → API keys):
VITE_MAP_KEY=
# Or point at any raster provider (overrides VITE_MAP_KEY):
#   VITE_TILE_URL=https://{s}.tile.example.com/{z}/{x}/{y}.png
#   VITE_TILE_ATTRIB=© Example
# VITE_TILE_URL=none disables the basemap (draws only the track).
# Add any custom tile host to img-src in nginx/default.conf.template.
VITE_TILE_URL=
VITE_TILE_ATTRIB=

# --- MCP server (optional; docker compose --profile mcp) --------------------
# Nothing secret here: each MCP client sends its own API token created in the
# web app (Import > Jetons d'accès (API) > "Accès complet — MCP / assistant",
# scope hub:full) as "Authorization: Bearer <token>". Revoke it to cut access.
# Published on this host only by default; set 0.0.0.0 to reach it from the
# LAN (never expose it to the Internet without a VPN / authenticated proxy).
MCP_BIND=127.0.0.1
MCP_PORT=9000
# streamable-http (recommended): each request gets its JSON answer, a single
# curl can call a tool. sse: answers arrive on a separate /sse stream.
MCP_TRANSPORT=streamable-http
# Only for MCP_TRANSPORT=stdio (no HTTP header to carry a token):
# PHOENIX_API_TOKEN=
